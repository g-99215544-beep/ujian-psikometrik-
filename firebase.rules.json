{
  "rules": {
    "ujianpsikometrikapp": {
      "meta": {
        ".read": true,
        ".write": false
      },
      "muridByIc": {
        ".read": false,
        ".write": false,
        "$ic": {
          ".read": true,
          ".write": false
        }
      },
      "borangJawapanByIc": {
        ".read": true,
        "$ic": {
          ".write": true,
          ".validate": "newData.hasChildren(['murid', 'jawapan', 'summary', 'updatedAtIso'])"
        }
      }
    }
  }
}
